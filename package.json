{
  "name": "dsh-novel-continue",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness (DSH) 网文续写插件：续写指挥 Agent 调度读原文、规划、写作、审稿、改稿、更新备忘等节点，每个节点用写死的模型与提示词。",
  "main": "./dist/novel.js",
  "types": "./src/novel.ts",
  "exports": {
    ".": {
      "types": "./src/novel.ts",
      "default": "./dist/novel.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npx -y esbuild@0.24.0 src/novel.ts --format=esm --platform=node --target=node22 --outfile=dist/novel.js",
    "test": "node --test tests/novel.test.mjs",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "novel",
    "writing"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "prompts",
    "src",
    "cordis.patch.yml",
    "scripts/install-local.sh",
    "LICENSE"
  ]
}
