{
  "name": "chuanban-dsh-writingset",
  "version": "0.3.0",
  "type": "module",
  "description": "DeepSeek Harness (DSH) 纯净写作协作模式插件（与 Storydesk 工作台内核等效）",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./src/presets.ts",
      "default": "./dist/presets.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./file-butler": {
      "types": "./src/file-butler.ts",
      "default": "./dist/file-butler.js"
    },
    "./doc-bridge": {
      "types": "./src/doc-bridge.ts",
      "default": "./dist/doc-bridge.js"
    },
    "./novel": {
      "types": "./src/novel.ts",
      "default": "./dist/novel.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build-client.mjs",
    "test": "node ./tests/verify-bundle.mjs",
    "switch": "node ./scripts/switch-preset.mjs",
    "prepublishOnly": "node ./scripts/build-client.mjs && node ./tests/verify-bundle.mjs",
    "build:novel": "npx -y esbuild@0.24.0 src/novel.ts --format=esm --platform=node --target=node22 --outfile=dist/novel.js",
    "test:novel": "node --test tests/novel.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "writing",
    "storydesk",
    "preset"
  ],
  "author": "船板",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anarcadia/chuanban-dsh-writingset.git"
  },
  "files": [
    "cordis.patch.yml",
    "dist",
    "prompts",
    "src"
  ]
}
